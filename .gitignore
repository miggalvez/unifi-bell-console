# OS noise
.DS_Store

# Local credentials — copy .env.example and fill in per machine. Never commit:
# these hold the Protect admin password and API key.
.env
.env.local

# Runtime data: the live SQLite database (password hashes, sessions, audit
# trail), staff voice recordings, and database backups. State, not source.
console/data/
console/backups/

# Filled-in site sheet — one building's network layout, hardware locations,
# and contacts, for the machine that runs its PA. Copy SITE-TEMPLATE.md (which
# is committed) per install and keep the result here, unpublished.
deploy/SITE.md

# Phase-0 run evidence (hardware probe output)
phase0/results/

# Local sound library — deployments bring their own audio; not part of the repo
sound-pack/

# Dependencies / build output (also covered per-package for tooling that
# reads nested .gitignore files)
node_modules/
.next/
*.tsbuildinfo
