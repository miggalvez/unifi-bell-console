# Copy to .env and fill in. Never commit .env.

# LAN address of the UniFi console (Dream Machine Pro), no scheme, no port.
PROTECT_HOST=192.168.1.1

# API key for the official Protect Integration API.
# Create at unifi.ui.com -> Settings -> API Keys (shown once, store it here).
PROTECT_API_KEY=

# Dedicated LOCAL admin on the console (not your Ubiquiti SSO account).
# Console -> Admins & Users -> Add Admin -> "Restrict to local access only",
# give it Protect access. Needed only for the private-API commands (discover
# detail dump, tts). Official-API commands work with the API key alone.
PROTECT_USERNAME=
PROTECT_PASSWORD=

# Set to "true" only if your console has a trusted TLS certificate.
# Consoles ship with a self-signed cert, so verification is off by default.
PROTECT_TLS_VERIFY=false

# Optional: console ID for the official cloud-connector fallback (used only when
# the local API rejects the key — Site Manager keys can lag syncing to consoles).
# Find it in the unifi.ui.com URL when the console is open: /consoles/<THIS PART>/protect
PROTECT_CONSOLE_ID=
