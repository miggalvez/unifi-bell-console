{
  "name": "bell-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,green \"next dev\" \"tsx watch worker/index.ts\"",
    "dev:web": "next dev",
    "dev:worker": "tsx watch worker/index.ts",
    "build": "next build",
    "start:web": "next start -p 3000",
    "start:worker": "tsx worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup:local": "tsx scripts/backup-local.ts",
    "backup:offsite": "tsx scripts/backup-offsite.ts",
    "backup:restore": "tsx scripts/restore-backup.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "seed-demo": "DB_PATH=data/demo.db tsx scripts/seed-demo.ts",
    "demo": "npm run seed-demo && DB_PATH=data/demo.db next dev -p 3001"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.29.0",
    "luxon": "^3.7.2",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.10.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
