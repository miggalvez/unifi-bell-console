# Copy to .env and fill in. Never commit .env.

# UniFi console (NVR running Protect) on the LAN
PROTECT_HOST=192.168.1.1

# API key created on the console's own Protect -> Integrations page.
# (Site Manager keys only work via the cloud connector — see phase0/README.md)
PROTECT_API_KEY=

# Dedicated LOCAL console admin (not Ubiquiti SSO) — powers the private TTS path
PROTECT_USERNAME=
PROTECT_PASSWORD=

# Consoles ship self-signed certs; set true only with a trusted cert installed
PROTECT_TLS_VERIFY=false

# Optional: console ID for the cloud-connector fallback (from the unifi.ui.com URL)
PROTECT_CONSOLE_ID=

# SQLite database file (default: ./data/bell.db)
# DB_PATH=

# School timezone (default: America/Chicago)
# SCHOOL_TZ=

# Set true when serving over HTTPS so session cookies are Secure
SECURE_COOKIES=false

# ffmpeg/ffprobe, needed for uploaded-audio streaming (default: on PATH)
# FFMPEG_PATH=
# FFPROBE_PATH=
